# Anthropic API Key and Model for Claude script & ideas generation
# Falls back to deterministic local generator when unset.
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL="claude-sonnet-5-5"

# VoiceStudio Local TTS Server (https://github.com/debpalash/VoiceStudio)
# Exposes OpenAI-compatible POST /v1/audio/speech on port 3900 by default.
# Loopback requests do not require an API key unless OMNIVOICE_API_KEY is set.
# Automatically falls back to MockProvider if VoiceStudio is unreachable.
VOICESTUDIO_URL="http://127.0.0.1:3900"
VOICESTUDIO_API_KEY=""
VOICESTUDIO_VOICE="alloy"
VOICESTUDIO_MODEL="tts-1"

# Gemini API Key (optional environment secret)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
